# Files excluded from `gcloud app deploy` uploads (project root).
# https://cloud.google.com/sdk/gcloud/reference/topic/gcloudignore

.gcloudignore
.git
.gitignore

#!include:.gitignore

# Dev / local only
.env
.venv/
tests/
plans/
docs/
.cursor/
.cursorrules
pytest-cache-files-*/

# Vendored flask-base copies (app uses the release wheel in requirements.txt)
flask_base/
flask_base_old/
_tmp_flaskbase/

# Windows helpers (not needed on App Engine)
*.bat

# One-off scripts (Firestore maintenance; not part of the web app)
src/scripts/
